root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{kt,kts,java}]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,css,html,json}]
indent_style = space
indent_size = 2

# Markdown uses trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false
